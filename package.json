{
  "name": "secuguard",
  "displayName": "SecuGuard — Personal QA Engineer",
  "description": "Embedded security + quality engineer for VS Code: vulnerability scanning, AI triage with Gemini/Groq failover, QA readiness checks, unit-test generation, and final QA reports.",
  "version": "0.1.0",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "vulnerability",
    "sast",
    "secrets",
    "owasp",
    "cwe"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "secuguard.scanWorkspace",
        "title": "SecuGuard: Scan Workspace",
        "icon": "$(search)"
      },
      {
        "command": "secuguard.scanCurrentFile",
        "title": "SecuGuard: Scan Current File",
        "icon": "$(file-code)"
      },
      {
        "command": "secuguard.explainVulnerability",
        "title": "SecuGuard: Explain & Fix This Vulnerability"
      },
      {
        "command": "secuguard.refreshAiAnalysis",
        "title": "SecuGuard: Refresh AI Analysis"
      },
      {
        "command": "secuguard.generateTest",
        "title": "SecuGuard: Generate Test for Finding"
      },
      {
        "command": "secuguard.generateAllTests",
        "title": "SecuGuard: Generate All Missing Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "secuguard.generateFinalReport",
        "title": "SecuGuard: Generate Final QA Report",
        "icon": "$(report)"
      },
      {
        "command": "secuguard.saveToBacklog",
        "title": "SecuGuard: Save to Vulnerability List"
      },
      {
        "command": "secuguard.addTodo",
        "title": "SecuGuard: Add as TODO"
      },
      {
        "command": "secuguard.markFalsePositive",
        "title": "SecuGuard: Mark False Positive"
      },
      {
        "command": "secuguard.markFixed",
        "title": "SecuGuard: Mark Fixed"
      },
      {
        "command": "secuguard.setGithubUsername",
        "title": "SecuGuard: Set GitHub Username"
      },
      {
        "command": "secuguard.reloadFromDisk",
        "title": "SecuGuard: Reload Findings from Disk"
      },
      {
        "command": "secuguard.exportReport",
        "title": "SecuGuard: Export Report (MD/CSV/SARIF/JSON)"
      },
      {
        "command": "secuguard.openDashboard",
        "title": "SecuGuard: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "secuguard.refreshTree",
        "title": "SecuGuard: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "secuguard.clearBaseline",
        "title": "SecuGuard: Clear Baseline / Reset"
      },
      {
        "command": "secuguard.filterBySeverity",
        "title": "SecuGuard: Filter by Severity",
        "icon": "$(filter)"
      },
      {
        "command": "secuguard.filterToSeverity",
        "title": "SecuGuard: Filter Explorer to Severity",
        "icon": "$(filter-filled)"
      },
      {
        "command": "secuguard.clearSeverityFilter",
        "title": "SecuGuard: Clear Severity Filter",
        "icon": "$(close)"
      },
      {
        "command": "secuguard.groupBy",
        "title": "SecuGuard: Change Explorer Grouping",
        "icon": "$(list-selection)"
      },
      {
        "command": "secuguard.rescanFile",
        "title": "SecuGuard: Rescan This File",
        "icon": "$(refresh)"
      },
      {
        "command": "secuguard.copyFindings",
        "title": "SecuGuard: Copy Findings as Markdown",
        "icon": "$(clippy)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "secuguard",
          "title": "SecuGuard",
          "icon": "resources/shield.svg"
        }
      ]
    },
    "views": {
      "secuguard": [
        {
          "id": "secuguard.explorer",
          "name": "Security Explorer"
        },
        {
          "id": "secuguard.summary",
          "name": "Summary"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "secuguard.explorer",
        "contents": "$(shield) **SecuGuard hasn't scanned this workspace yet.**\n\nIt checks code, dependencies, secrets and IaC for security problems — plus quality debt, missing tests and missing docs. Everything runs locally: findings are written to `.secuguard/` and never uploaded.\n\n[$(rocket) Run first scan](command:secuguard.scanWorkspace)\n[$(dashboard) Open dashboard](command:secuguard.openDashboard)\n[$(gear) Settings](command:workbench.action.openSettings?%22secuguard%22)\n\nOnce a scan finishes, findings appear here grouped by category — with AI explanations, one-click test generation and a QA health score."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "secuguard.scanWorkspace",
          "when": "view == secuguard.explorer",
          "group": "navigation@1"
        },
        {
          "command": "secuguard.openDashboard",
          "when": "view == secuguard.explorer",
          "group": "navigation@2"
        },
        {
          "command": "secuguard.filterBySeverity",
          "when": "view == secuguard.explorer",
          "group": "navigation@3"
        },
        {
          "command": "secuguard.refreshTree",
          "when": "view == secuguard.explorer",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "secuguard.explainVulnerability",
          "when": "view == secuguard.explorer && viewItem == finding",
          "group": "inline@1"
        },
        {
          "command": "secuguard.refreshAiAnalysis",
          "when": "view == secuguard.explorer && viewItem == finding",
          "group": "inline@1.5"
        },
        {
          "command": "secuguard.generateTest",
          "when": "view == secuguard.explorer && viewItem == finding",
          "group": "inline@1.6"
        },
        {
          "command": "secuguard.saveToBacklog",
          "when": "view == secuguard.explorer && viewItem == finding"
        },
        {
          "command": "secuguard.addTodo",
          "when": "view == secuguard.explorer && viewItem == finding"
        },
        {
          "command": "secuguard.markFalsePositive",
          "when": "view == secuguard.explorer && viewItem == finding"
        },
        {
          "command": "secuguard.markFixed",
          "when": "view == secuguard.explorer && viewItem == finding"
        }
      ],
      "editor/context": [
        {
          "command": "secuguard.scanCurrentFile",
          "group": "secuguard"
        }
      ],
      "commandPalette": [
        {
          "command": "secuguard.scanWorkspace"
        },
        {
          "command": "secuguard.generateAllTests"
        },
        {
          "command": "secuguard.generateFinalReport"
        },
        {
          "command": "secuguard.scanCurrentFile"
        },
        {
          "command": "secuguard.openDashboard"
        },
        {
          "command": "secuguard.exportReport"
        },
        {
          "command": "secuguard.markFixed"
        },
        {
          "command": "secuguard.setGithubUsername"
        },
        {
          "command": "secuguard.reloadFromDisk"
        }
      ]
    },
    "configuration": {
      "title": "SecuGuard",
      "properties": {
        "secuguard.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run an incremental scan on the current file every time it is saved."
        },
        "secuguard.severityThreshold": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "default": "low",
          "description": "Minimum severity shown in the Problems panel and Security Explorer."
        },
        "secuguard.excludeGlobs": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/.git/**",
            "**/.secuguard/**",
            "**/test-fixtures/**",
            "**/*.min.js"
          ],
          "description": "Glob patterns excluded from scanning. SecuGuard's own data directory (.secuguard/) is always excluded."
        },
        "secuguard.useSemgrepIfAvailable": {
          "type": "boolean",
          "default": true,
          "description": "Shell out to a locally installed Semgrep binary for deeper multi-language coverage, if found on PATH."
        },
        "secuguard.ai.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable AI-assisted triage (sends only the flagged snippet + minimal context, never full files, to the configured model)."
        },
        "secuguard.ai.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "gemini",
            "groq"
          ],
          "default": "gemini",
          "description": "AI provider used for triage / fix suggestions. Gemini is the free option by default; groq also offers a free tier."
        },
        "secuguard.ai.apiKeyEnvVar": {
          "type": "string",
          "default": "",
          "description": "Name of the environment variable holding your AI API key. When empty, defaults per provider: GEMINI_API_KEY (gemini), GROQ_API_KEY (groq), ANTHROPIC_API_KEY (anthropic). The key itself is never stored in settings."
        },
        "secuguard.ai.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Model used for AI triage / fix suggestions. Defaults per provider when unset: gemini-2.5-flash (gemini), llama-3.3-70b-versatile (groq), claude-sonnet-4-6 (anthropic)."
        },
        "secuguard.ai.fallbackProvider": {
          "type": "string",
          "enum": [
            "",
            "groq",
            "gemini"
          ],
          "default": "",
          "description": "Provider to retry with once when the primary hits a 429/quota error. When empty, SecuGuard picks gemini→groq / groq→gemini automatically. Not used by anthropic."
        },
        "secuguard.ai.maxConcurrentCalls": {
          "type": "number",
          "default": 2,
          "description": "Maximum simultaneous AI API calls (used during batch test generation and parallel triage)."
        },
        "secuguard.ai.testGenBatchSize": {
          "type": "number",
          "default": 6,
          "description": "Number of findings per batch during 'Generate All Missing Tests'."
        },
        "secuguard.attribution.githubUsername": {
          "type": "string",
          "default": "",
          "description": "GitHub username used to attribute SecuGuard status changes. Overrides automatic detection when set."
        },
        "secuguard.attribution.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect the attributing identity from the `gh` CLI, then `git config user.name` as a fallback."
        },
        "secuguard.baselineOnFirstRun": {
          "type": "boolean",
          "default": true,
          "description": "Mark all findings from the very first scan as pre-existing backlog instead of new alerts."
        },
        "secuguard.quality.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the quality scanner (TODO markers, long functions, deep nesting, debug statements)."
        },
        "secuguard.quality.maxFunctionLines": {
          "type": "number",
          "default": 80,
          "description": "Functions longer than this many lines are flagged as quality debt."
        },
        "secuguard.quality.maxNestingDepth": {
          "type": "number",
          "default": 4,
          "description": "Code nested deeper than this many levels is flagged as quality debt."
        },
        "secuguard.testCoverage.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the test-coverage scanner (checks every exported symbol for an associated test file)."
        },
        "secuguard.testCoverage.testFileGlobs": {
          "type": "array",
          "default": [
            "**/*.test.*",
            "**/*.spec.*",
            "**/test_*.py",
            "**/__tests__/**"
          ],
          "description": "Glob patterns that identify test files used by the coverage scanner."
        },
        "secuguard.docs.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the documentation scanner (flags exported symbols without JSDoc/docstrings)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run build -- --watch",
    "compile-check": "tsc --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  }
}
